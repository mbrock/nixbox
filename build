#!/usr/bin/env bash
# nix build with the optional authenticated binary cache (docs/cache.md).
#   ./build [OUTPUT] [NIX BUILD ARGS…]   (default output: hello)
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source "$root/bin/nix-cache-options"
output=${1:-hello}
shift || true
nix build "${nix_options[@]}" "$root#$output" "$@"
