diff --git a/src/runtime/wrap.c b/src/runtime/wrap.c
index b21b189..bd454a6 100644
--- a/src/runtime/wrap.c
+++ b/src/runtime/wrap.c
@@ -21,7 +21,9 @@
 #include "genesis/sbcl.h"
 
 #include <sys/types.h>
+#ifndef _MSC_VER
 #include <dirent.h>
+#endif
 #include <sys/stat.h>
 #include <stdlib.h>
 #include <string.h>
@@ -148,6 +150,65 @@ char * sb_realpath (char *path)
  *
  * Once that is done, the lisp side functions are best named OS-OPENDIR, etc.
  */
+#ifdef _MSC_VER
+struct sb_directory {
+    intptr_t handle;
+    struct __finddata64_t entry;
+    int first;
+};
+
+struct sb_directory* sb_opendir(char* name)
+{
+    struct _stat st;
+    if (_stat(name, &st) < 0) return NULL;
+    if ((st.st_mode & _S_IFMT) != _S_IFDIR) {
+        errno = ENOTDIR;
+        return NULL;
+    }
+    struct sb_directory* dir = malloc(sizeof(*dir));
+    char* pattern = malloc(strlen(name) + 3);
+    if (!dir || !pattern) {
+        free(dir);
+        free(pattern);
+        errno = ENOMEM;
+        return NULL;
+    }
+    sprintf(pattern, "%s\\*", name);
+    dir->handle = _findfirst64(pattern, &dir->entry);
+    free(pattern);
+    dir->first = dir->handle != -1;
+    if (dir->handle == -1 && errno != ENOENT) {
+        free(dir);
+        return NULL;
+    }
+    return dir;
+}
+
+struct __finddata64_t* sb_readdir(struct sb_directory* dir)
+{
+    errno = 0;
+    if (dir->handle == -1) return NULL;
+    if (dir->first) {
+        dir->first = 0;
+        return &dir->entry;
+    }
+    if (_findnext64(dir->handle, &dir->entry) == 0) return &dir->entry;
+    if (errno == ENOENT) errno = 0;
+    return NULL;
+}
+
+int sb_closedir(struct sb_directory* dir)
+{
+    int result = dir->handle == -1 ? 0 : _findclose(dir->handle);
+    free(dir);
+    return result;
+}
+
+char* sb_dirent_name(struct __finddata64_t* entry)
+{
+    return entry->name;
+}
+#else
 extern DIR *
 sb_opendir(char * name)
 {
