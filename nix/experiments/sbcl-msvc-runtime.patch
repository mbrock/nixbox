diff --git a/build-output/sbcl-runtime-work/src/runtime/nixbox-win32.h b/src/runtime/nixbox-win32.h
new file mode 100644
index 0000000..64bb966
--- /dev/null
+++ b/src/runtime/nixbox-win32.h
@@ -0,0 +1,44 @@
+#ifndef SBCL_NIXBOX_WIN32_H
+#define SBCL_NIXBOX_WIN32_H
+#ifndef __ASSEMBLER__
+
+/* SBCL-local MSVC compatibility and deliberate Developer Mode imports.
+ * Keep the shared SDK's app partition intact. VirtualAlloc/Protect must be
+ * the real exports: the SDK's inline FromApp wrappers reject RWX allocation. */
+#ifdef SBCL_HEADER_GROVEL
+/* The build helper extracts desktop constants but never calls those APIs.
+ * Select its partition before any Windows headers, not halfway through them. */
+#undef WINAPI_FAMILY
+#define WINAPI_FAMILY WINAPI_FAMILY_DESKTOP_APP
+#endif
+#define WIN32_LEAN_AND_MEAN
+#define VirtualAlloc sbcl_sdk_VirtualAlloc
+#define VirtualProtect sbcl_sdk_VirtualProtect
+#include <winsock2.h>
+#include <windows.h>
+#undef VirtualAlloc
+#undef VirtualProtect
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <io.h>
+#include <sys/types.h>
+#include <sys/stat.h>
+
+typedef unsigned short mode_t;
+typedef intptr_t ssize_t;
+#define strcasecmp _stricmp
+#define getpid() ((int)GetCurrentProcessId())
+/* Real CRT implementation, omitted only by the SDK's desktop header guard. */
+_ACRTIMP char* __cdecl getenv(const char*);
+
+__declspec(dllimport) LPVOID WINAPI VirtualAlloc(LPVOID, SIZE_T, DWORD, DWORD);
+__declspec(dllimport) BOOL WINAPI VirtualProtect(LPVOID, SIZE_T, DWORD, PDWORD);
+__declspec(dllimport) PVOID WINAPI AddVectoredExceptionHandler(ULONG, PVECTORED_EXCEPTION_HANDLER);
+__declspec(dllimport) BOOL WINAPI SetThreadStackGuarantee(PULONG);
+__declspec(dllimport) LPWSTR* WINAPI CommandLineToArgvW(LPCWSTR, int*);
+__declspec(dllimport) HRESULT WINAPI SHGetFolderPathA(HWND, int, HANDLE, DWORD, LPSTR);
+__declspec(dllimport) BOOL WINAPI CryptGenRandom(ULONG_PTR, DWORD, BYTE*);
+
+#endif
+#endif
