+
+#ifdef WINDOWS_NATIVE
+/* CreateFileA is desktop-only. Keep gnulib's ANSI path interpretation while
+   using the UWP file-opening API and preserving its error for the caller. */
+static HANDLE
+uwp_open_stat_file (const char *name)
+{
+  int count = MultiByteToWideChar (CP_ACP, 0, name, -1, NULL, 0);
+  if (!count)
+    return INVALID_HANDLE_VALUE;
+  wchar_t *wide = HeapAlloc (GetProcessHeap (), 0, count * sizeof *wide);
+  if (!wide)
+    {
+      SetLastError (ERROR_NOT_ENOUGH_MEMORY);
+      return INVALID_HANDLE_VALUE;
+    }
+  HANDLE result = INVALID_HANDLE_VALUE;
+  if (MultiByteToWideChar (CP_ACP, 0, name, -1, wide, count))
+    {
+      CREATEFILE2_EXTENDED_PARAMETERS params = { 0 };
+      params.dwSize = sizeof params;
+      params.dwFileAttributes = FILE_ATTRIBUTE_NORMAL;
+      params.dwFileFlags = FILE_FLAG_BACKUP_SEMANTICS;
+      result = CreateFile2 (wide, FILE_READ_ATTRIBUTES,
+                           FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                           OPEN_EXISTING, &params);
+    }
+  DWORD error = GetLastError ();
+  HeapFree (GetProcessHeap (), 0, wide);
+  SetLastError (error);
+  return result;
+}
 #endif
 
