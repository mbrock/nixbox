+def test_extensionless_parts_get_content_type_overrides(tmp_path: Path):
+    layout = tmp_path / "layout"
+    (layout / "levels" / "world1").mkdir(parents=True)
+    (layout / "AppxManifest.xml").write_text("<Package/>", encoding="utf-8")
+    (layout / "README").write_bytes(b"credits")
+    (layout / "levels" / "world1" / "info").write_bytes(b"level metadata")
+    (layout / "empty").write_bytes(b"")
+
+    out = pack_python(layout, tmp_path / "out.msix")
+    with zipfile.ZipFile(out) as zf:
+        types = ET.fromstring(zf.read("[Content_Types].xml"))
+    ns = "{http://schemas.openxmlformats.org/package/2006/content-types}"
+    overrides = {
+        entry.get("PartName"): entry.get("ContentType")
+        for entry in types.findall(f"{ns}Override")
+    }
+    for name in ["/README", "/levels/world1/info", "/empty"]:
+        assert overrides[name] == "application/octet-stream"
+
+
