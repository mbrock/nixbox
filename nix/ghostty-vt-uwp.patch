+/// UWP pages must use the App-family API, not Zig's NT page allocator.
+pub const windows_page_allocator: Allocator = .{
+    .ptr = undefined,
+    .vtable = &.{
+        .alloc = windowsPageAlloc,
+        .resize = Allocator.noResize,
+        .remap = Allocator.noRemap,
+        .free = windowsPageFree,
+    },
+};
+
+fn windowsPageAlloc(_: *anyopaque, len: usize, alignment: std.mem.Alignment, _: usize) ?[*]u8 {
+    // VirtualAllocFromApp reserves at allocation-granularity (64 KiB) boundaries.
+    if (alignment.toByteUnits() > 65536) return null;
+    return (AllocWindows.alloc(len) catch return null).ptr;
+}
+
+fn windowsPageFree(_: *anyopaque, memory: []u8, _: std.mem.Alignment, _: usize) void {
+    AllocWindows.free(@alignCast(memory));
+}
